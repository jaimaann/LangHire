# Usage analytics proxy endpoint (optional — analytics is a silent no-op if absent).
# A maintainer-run proxy that receives POST JSON {client_id, events} and forwards
# it to GA4 Measurement Protocol, adding the measurement id and api_secret
# SERVER-SIDE. Never put an analytics secret in a VITE_* variable: every VITE_*
# value is baked into the client bundle. Telemetry is opt-in; nothing is sent
# unless the user enables it.
VITE_ANALYTICS_ENDPOINT=
# Sentry DSN for crash reporting (optional — disabled if absent; opt-in only)
VITE_SENTRY_DSN=
# GitHub token for feedback submissions
VITE_GITHUB_TOKEN=
